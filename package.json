{
  "name": "noxoracle-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NoxOracle — private positions on a real Gnosis CTF prediction market (iExec Nox / WTF!! Hackathon)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "lint": "npm --prefix web run lint",
    "typecheck": "npm --prefix web run typecheck",
    "build": "npm --prefix web run build",
    "compile": "hardhat compile",
    "test": "vitest run --root packages/confidential-ctf",
    "test:contracts": "hardhat test",
    "coverage": "hardhat coverage",
    "coverage:check": "hardhat coverage && node scripts/check-coverage.mjs",
    "test:all": "npm test && npm run test:contracts",
    "check-artifacts": "tsx scripts/check_artifacts.mjs",
    "gateway-smoke": "tsx scripts/gateway-smoke.mjs",
    "deploy": "tsx scripts/deploy.mjs",
    "seed": "tsx scripts/seed.mjs",
    "e2e": "tsx scripts/e2e.mjs",
    "bench": "tsx scripts/bench.mjs",
    "verify-epoch": "tsx scripts/verify_epoch.mjs",
    "check-readiness": "tsx scripts/check_submission_readiness.mjs",
    "cli": "tsx packages/cli/src/index.ts"
  },
  "dependencies": {
    "@iexec-nox/handle": "^0.1.0-beta.13",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@gnosis.pm/conditional-tokens-contracts": "1.0.3",
    "@gnosis.pm/conditional-tokens-market-makers": "1.8.1",
    "@iexec-nox/nox-confidential-contracts": "^0.2.2",
    "@iexec-nox/nox-protocol-contracts": "^0.2.4",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.20.1",
    "hardhat": "^2.28.6",
    "solidity-coverage": "^0.8.17",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
